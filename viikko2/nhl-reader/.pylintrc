cat > .pylintrc <<'RC'
[MAIN]
ignore = .venv, venv, .git, __pycache__
init-hook = import sys; sys.path.append("src")

[MESSAGES CONTROL]

[FORMAT]
max-line-length = 100
indent-string = "    "

[REFACTORING]
max-nested-blocks = 2

[DESIGN]
max-args = 6
max-positional-arguments = 6
max-statements = 10

[BASIC]
bad-functions = print
RC
